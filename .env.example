# EmailJS credentials for the contact form (https://dashboard.emailjs.com)
# Copy this file to `.env` for local dev. For production, add the same three
# values as GitHub repository secrets — the deploy workflow injects them.
#
# Until these are set, the form falls back to opening the visitor's email app
# with the message pre-filled (so contact still works).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
